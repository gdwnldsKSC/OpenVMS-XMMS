+/* OpenVMS-XMMS: legacy st_dev is a borrowed device-name string, not a
+ * unique numeric ID. Compare its value and copy it before retaining it
+ * across CRTL calls. The complete three-word FID remains the file ID.
+ */
+static gboolean
+vms_device_equal (const gchar *a, const gchar *b)
+{
+  return a && b && strcmp (a, b) == 0;
